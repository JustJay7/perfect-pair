{
  "name": "perfect-pair",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node backend/server.mjs",
    "build": "python3 app/source/build.py && python3 tools/install_build.py",
    "test": "node --test tests/*.test.mjs",
    "test:actions": "node backend/action-tests.mjs",
    "test:data": "python3 -m unittest discover -s tests -p \"test_*.py\"",
    "import:history": "python3 tools/import_evidence.py",
    "import:transactions": "python3 tools/import_transactions.py"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "3.1152.0",
    "ajv": "8.20.0"
  }
}
