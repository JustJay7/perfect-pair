{
  "name": "perfect-pair",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node backend/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:ui-audit": "node tests/ui_audit_browser.cjs",
    "test:browser": "node tests/browser_smoke.cjs",
    "test:bedrock-browser": "node tests/bedrock_browser.cjs",
    "test:bedrock-live": "node tests/bedrock_live.cjs",
    "check:aws": "node backend/check-aws.mjs",
    "import:history": "python3 source/import_evidence.py",
    "test:workspace-browser": "node tests/workspace_browser.cjs",
    "test:navigation-browser": "node tests/navigation_browser.cjs",
    "test:experience-browser": "node tests/experience_browser.cjs",
    "test:journeys-browser": "node tests/journeys_browser.cjs",
    "test:insights-browser": "node tests/insights_browser.cjs",
    "test:manager-browser": "node tests/manager_browser.cjs",
    "import:transactions": "python3 source/import_transactions.py",
    "test:transactions-import": "python3 -m unittest discover -s tests -p test_transactions_import.py",
    "test:transactions-browser": "node tests/transactions_browser.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "3.1152.0",
    "ajv": "8.20.0"
  }
}
